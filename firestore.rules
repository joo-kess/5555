rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function playerForUid(uid) {
      return uid == 'BxuYNBkmwmP7wa7298P2vNd3djz2' ? 'yousef'
        : uid == 'SET_LUJAIN_UID' ? 'lujain'
        : null;
    }
    function validEntry(entryId) {
      return request.resource.data.keys().hasAll(['id', 'player', 'date', 'type', 'label', 'points', 'createdAt'])
        && request.resource.data.keys().hasOnly(['id', 'player', 'date', 'type', 'label', 'points', 'createdAt'])
        && request.resource.data.id == entryId
        && request.resource.data.player == playerForUid(request.auth.uid)
        && request.resource.data.date is string
        && request.resource.data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && request.resource.data.type is string
        && request.resource.data.label is string
        && request.resource.data.label.size() <= 60
        && request.resource.data.createdAt is number
        && ((request.resource.data.type in ['fajr','dhuhr','asr','maghrib','isha'] && request.resource.data.points == 1)
          || (request.resource.data.type in ['daily_bonus','qiyam','sunnah','extra_prayer','duha','witr','other'] && request.resource.data.points == 5));
    }
    match /activity/{entryId} {
      allow read: if request.auth != null && playerForUid(request.auth.uid) != null;
      allow create, update: if request.auth != null && validEntry(entryId);
      allow delete: if request.auth != null
        && resource.data.player == playerForUid(request.auth.uid);
    }
  }
}
